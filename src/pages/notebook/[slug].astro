
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import Markdoc from "@markdoc/markdoc";

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const entries = await reader.collections.notebook.all();

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { note: entry.entry },
  }));
}

const { note } = Astro.props;

const content = await note.content();
const html = Markdoc.renderers.html(
  Markdoc.transform(content.node)
);
---

<BaseLayout title={`${note.title} | My Digital Garden`}>
  <main class="mx-auto w-full max-w-3xl px-6 py-10">

    <a
      href="/notebook"
      class="text-[var(--burnt-orange)] hover:underline"
    >
      ← Back to Notebook
    </a>

    <article class="mt-10">

      <h1 class="mb-8 text-5xl font-bold">
        {note.title}
      </h1>

      {note.image && (
        <img
          src={note.image}
          alt={note.title}
          class="mb-8 h-auto w-full"
        />
      )}

      <div
        class="prose prose-lg max-w-none"
        set:html={html}
      />

    </article>
  </main>
</BaseLayout>
